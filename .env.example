POSTGRES_DB=reel
POSTGRES_USER=reel
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+psycopg://reel:change_this_local_password@db:5432/reel
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Phase 4: authentication ---
# Required. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# First administrator, created on API start only when the users table is empty.
# Choose your own address and a unique password (min. 10 characters), then change it in Settings.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=REEL Admin

# --- Phase 5: file uploads ---
# Where uploaded recordings are stored. Docker Compose sets /data/uploads (a named volume) itself.
# For a local run without Docker, use a folder you own, e.g. ./data/uploads
UPLOAD_DIR=./data/uploads
# Maximum size of one uploaded recording, in megabytes.
MAX_UPLOAD_MB=2048

# --- Phase 6: background processing ---
# Redis broker. Docker Compose uses redis://redis:6379/0 automatically; for a local run use localhost.
REDIS_URL=redis://redis:6379/0
# A job running longer than this many seconds is stopped and marked failed.
JOB_TIMEOUT_SECONDS=900
# Parallel jobs per worker container.
WORKER_CONCURRENCY=2
